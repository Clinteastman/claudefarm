[Unit]
Description=Claude Code Remote (LXC 105) instance %i with Telegram notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
# %i is the instance name (the part after @ in the service unit)
# Default workdir is /root. Override per-instance with a drop-in:
#   mkdir -p /etc/systemd/system/claude-remote@dev.service.d
#   echo -e "[Service]\nEnvironment=CLAUDE_WORKDIR=/data/dev" > /etc/systemd/system/claude-remote@dev.service.d/workdir.conf
ExecStart=/usr/local/bin/claude-remote-with-telegram.sh %i
ExecStop=/usr/bin/tmux kill-session -t claude-%i
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
Environment=JOURNAL_SKIP=1
Environment=LANG=en_US.UTF-8
Environment=LC_ALL=en_US.UTF-8
# Exposed to the Claude Code statusline so each instance shows its own name
Environment=CLAUDE_INSTANCE=%i

[Install]
WantedBy=multi-user.target
