# Reference SSH config for the homelab. Mirror the relevant blocks into
# your real `~/.ssh/config` - do not commit your real ssh config (it may
# have non-K12 hosts).
#
# CRITICAL: per-instance Claude aliases (claude-homelab, claude-dev, etc.)
# come from a SEPARATE FILE auto-generated by `claude-mgr sync-ssh` on K12.
# That file is committed to this repo at desktop/claude-instances.cfg.
# Add this line to the TOP of your real ~/.ssh/config (before any Host blocks):
#
#   Include ~/github/claudefarm/client/claude-instances.cfg
#
# Then `git pull` whenever you create/remove K12 instances to get the
# updated aliases. Position matters - the Include must NOT be inside any
# Host stanza (Host scope leaks into Included files).
#
# Assumes ed25519 key at ~/.ssh/id_ed25519 (default), public key already
# added to authorized_keys on each target.

# Proxmox host (use for any LXC management via `pct exec`)
Host proxmox
  HostName 192.168.50.55
  User root

# Per-instance Claude attach + restart aliases come from desktop/claude-instances.cfg
# (auto-generated by claude-mgr) - see the Include directive note at the top of this file.
# Do NOT add manual claude-* aliases here; they'll be overwritten by the auto-generated set.

# Open the TUI to manage Claude instances on K12 (start/stop/restart/attach/
# create new instances in cloned repos / etc.). Whiptail menus over SSH.
Host claude-mgr
  HostName 192.168.50.62
  User root
  RequestTTY yes
  RemoteCommand /usr/local/bin/claude-mgr

# Sound detector Pi
Host satellite satellite.local
  HostName satellite.local
  User satellite
