# Reference ~/.ssh/config snippets for using claudefarm.
#
# DO NOT copy this file wholesale. Mirror only the bits you need into your
# real ~/.ssh/config (or %USERPROFILE%\.ssh\config on Windows).
#
# CRITICAL: the per-instance attach/restart aliases (claude-k12-main,
# claude-k12-homelab, etc.) come from SEPARATE files auto-generated by
# `claude-mgr sync-ssh` on each server: client/claude-instances-<host>.cfg.
# The Include line below picks them all up at once via glob.
#
# Position matters - the Include MUST be at the very top of the file,
# BEFORE any Host blocks. SSH leaks Host scope into Included files
# otherwise, which would nest the auto-generated aliases inside the
# wrong Host.

# === put this at the top of your real ~/.ssh/config ===
Include ~/github/claudefarm/client/claude-instances-*.cfg

# === then your normal Host blocks ===

# Optional: open the manager TUI on a server in one command. Add one of
# these per server (the alias name is up to you - use 'claude-mgr-<host>'
# to keep things consistent with the auto-generated aliases).
Host claude-mgr-k12
  HostName 192.168.50.62
  User root
  RequestTTY yes
  RemoteCommand /usr/local/bin/claude-mgr

# Add per-machine aliases as you like - they don't conflict with the
# auto-generated ones as long as the names don't clash.
Host k12
  HostName 192.168.50.62
  User root
